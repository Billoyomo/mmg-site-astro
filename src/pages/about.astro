---
import BaseLayout from "../layouts/BaseLayout.astro";
import team from "../data/team.json";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="About Us">
  <h1>About Us</h1>
  <p>
    The Materials Modelling Group is based at the Technical University of Kenya.
    We are dedicated in contributing to the advancement of theoretical and computational
    materials science. Our research focuses on predicting and understanding properties of
    materials using <i>first-principles</i> codes such as&nbsp;
    <a href="https://www.quantum-espresso.org/" target="_blank" title="Quantum ESPRESSO">QE</a>,&nbsp;
    <a href="https://www.vasp.at/" target="_blank" title="Vienna Ab initio Simulation Package">VASP</a>,&nbsp;
    <a href="https://siesta-project.org/siesta/" target="_blank" title="Spanish Initiative for Electronic Simulations with Thousands of Atoms">SIESTA</a>,&nbsp;
    <a href="https://abinit.github.io/abinit_web/" target="_blank">ABINIT</a>, and&nbsp;
    <a href="https://www.yambo-code.eu/" target="_blank">YAMBO</a>.
    The Materials Modelling Group is composed of researchers with expertise in condensed matter
    physics and computational techniques. The team includes faculty members and graduate students,
    all working collaboratively to address various research questions.
  </p>

  <h2>Our Members</h2>
  <ul class="grid team-grid">
    {team.map((member) => (
      <li class="card team-card">
        <img src={`${base}${member.photo.replace(/^\//, "")}`} alt={member.name} width="150" height="150" />
        <p>{member.name}</p>
        {member.url && (
        <p>
          <a href={member.url} target="_blank" rel="noopener noreferrer">Personal website</a>
        </p>
      )}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .team-card img {
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-xs);
  }

  .team-card p {
    margin: 0;
    font-weight: 500;
    color: var(--text-strong);
  }
</style>