---
import BaseLayout from "../layouts/BaseLayout.astro";
import publications from "../data/publications.json";

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
---

<BaseLayout title="Publications">
  <h1>Publications</h1>

  {years.map((year) => (
    <section>
      <h2>{year}</h2>
      <ul class="entry-list">
        {publications
          .filter((p) => p.year === year)
          .map((p) => (
            <li class="card entry-card">
              <span set:html={p.titleHtml} />
              <a class="entry-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.url}</a>
            </li>
          ))}
      </ul>
    </section>
  ))}
</BaseLayout>
